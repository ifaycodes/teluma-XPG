DATABASE_URL="Supabase db url"
SUPABASE_JWT_SECRET="your secret key"
SUPABASE_ANON_KEY=public_publishable_key
SUPABASE_URL=your_supabase_url

GCS_BUCKET_VAULT=GCS_BUCKET_VAULT
GCS_BUCKET_AGENT=GCS_BUCKET_AGENT
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=location_of_choice
GOOGLE_GENAI_USE_VERTEXAI=true

# comma-separated list of frontend origins allowed to call this API (CORS)
FRONTEND_ORIGINS=http://localhost:3000
# single frontend origin used for checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000

# Bachs (payments/billing) — sandbox first: https://sandbox-api.bachs.io with sk_sandbox_ keys
BACHS_API_KEY=sk_sandbox_your_key
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=your_webhook_signing_secret
# product IDs from your Bachs dashboard/catalog — see scripts/create_bachs_products.py
BACHS_PRODUCT_BASIC=prod_...
BACHS_PRODUCT_PRO=prod_...
BACHS_PRODUCT_ENTERPRISE=prod_...

# SendByte (transactional email)
SENDBYTE_API_KEY=sk_test_your_key
EMAIL_FROM=Teluma <hello@yourdomain.com>